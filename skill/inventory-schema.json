{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "osmosecure inventory",
  "type": "object",
  "required": ["schema_version", "generated_at", "owner", "assets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "owner": { "type": "string", "minLength": 1 },
    "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["id", "kind", "name", "version", "location", "detected_by"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
        "kind": { "enum": ["lockfile_package", "container_image", "host_runtime", "os_package"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "ecosystem": { "type": "string" },
        "distro": { "type": "string" },
        "distro_release": { "type": "string" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "location": { "type": "string", "minLength": 1 },
        "detected_by": { "type": "string", "minLength": 1 },
        "internet_exposed": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
