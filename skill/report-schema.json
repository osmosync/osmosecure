{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "osmosecure report",
  "type": "object",
  "required": ["schema_version", "mode", "generated_at", "scope", "coverage", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "enum": ["inventory_audit", "disclosure_watch", "remediation_plan"] },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "scope": {
      "type": "object",
      "required": ["owner", "own_assets_confirmed"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "own_assets_confirmed": { "const": true },
        "inventory_generated_at": { "type": "string" }
      }
    },
    "coverage": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/coverage" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "remediation_plan": { "$ref": "#/$defs/plan" }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "required": ["source", "status", "checked_at", "asset_ids"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "status": { "enum": ["checked", "partial", "skipped", "failed"] },
        "checked_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "asset_ids": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "title", "verdict", "severity", "origin", "advisory", "affected", "hunter", "verifier"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^F-\\d{3,}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "verdict": { "enum": ["confirmed", "needs_validation", "rejected"] },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "origin": { "enum": ["scanner", "free_text_disclosure", "both"] },
        "advisory": {
          "type": "object",
          "required": ["ids", "source", "url"],
          "additionalProperties": false,
          "properties": {
            "ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "source": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://" },
            "published_at": { "type": "string" },
            "embargo_respected": { "type": "boolean" },
            "excerpt": { "type": "string", "maxLength": 500 },
            "kev": { "type": "boolean" },
            "epss": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "affected": {
          "type": "object",
          "required": ["asset_id", "installed_version", "match_basis"],
          "additionalProperties": false,
          "properties": {
            "asset_id": { "type": "string" },
            "installed_version": { "type": "string", "minLength": 1 },
            "upstream_fixed_version": { "type": "string" },
            "distro_fixed_version": { "type": "string" },
            "match_basis": { "enum": ["package_range", "host_runtime_version", "distro_tracker", "image_layer", "manual_reading"] },
            "backport_checked": { "type": "boolean" },
            "reachable_note": { "type": "string" }
          }
        },
        "hunter": {
          "type": "object",
          "required": ["claim", "evidence"],
          "additionalProperties": false,
          "properties": {
            "claim": { "type": "string", "minLength": 1 },
            "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "verifier": {
          "type": "object",
          "required": ["disproof_attempts", "result"],
          "additionalProperties": false,
          "properties": {
            "disproof_attempts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "result": { "enum": ["survived", "disproved", "inconclusive"] },
            "notes": { "type": "string" }
          }
        },
        "open_question": { "type": "string" },
        "rejection_reason": { "type": "string" }
      }
    },
    "plan": {
      "type": "object",
      "required": ["pushes_or_deploys", "steps"],
      "additionalProperties": false,
      "properties": {
        "pushes_or_deploys": { "const": false },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "step": {
      "type": "object",
      "required": ["finding_id", "action", "dry_run", "approval", "rollback"],
      "additionalProperties": false,
      "properties": {
        "finding_id": { "type": "string" },
        "action": { "type": "string", "minLength": 1 },
        "command_preview": { "type": "string" },
        "dry_run": { "type": "boolean" },
        "approval": { "enum": ["pending", "approved", "declined"] },
        "approved_by": { "type": "string" },
        "rollback": { "type": "string", "minLength": 1 }
      }
    }
  }
}
